{
  // Static site served as a Cloudflare Worker with static assets (same platform as easyveo.com).
  "name": "easytoken",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // When easytoken.si is on this Cloudflare account, add:
  // , "routes": [{ "pattern": "easytoken.si", "custom_domain": true }, { "pattern": "www.easytoken.si", "custom_domain": true }]
}
